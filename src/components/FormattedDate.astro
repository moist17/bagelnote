---
interface Props {
	date: Date;
	format?: 'short' | 'full';
}

const { date, format = 'short' } = Astro.props;

// DD.MM format (e.g. 17.07)
const day = String(date.getDate()).padStart(2, '0');
const month = String(date.getMonth() + 1).padStart(2, '0');
const shortDate = `${day}.${month}`;

// Full format for post headers
const fullDate = date.toLocaleDateString('zh-TW', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<time datetime={date.toISOString()}>
	{format === 'short' ? shortDate : fullDate}
</time>
