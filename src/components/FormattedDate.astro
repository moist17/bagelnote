---
interface Props {
	date: Date;
	format?: 'short' | 'full' | 'iso';
}

const { date, format = 'short' } = Astro.props;

// DD.MM format (e.g. 17.07)
const day = String(date.getDate()).padStart(2, '0');
const month = String(date.getMonth() + 1).padStart(2, '0');
const shortDate = `${day}.${month}`;

// Full format for post headers
const fullDate = date.toLocaleDateString('zh-TW', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

// YYYY-MM-DD
const isoDate = `${date.getFullYear()}-${month}-${day}`;

const formatted = format === 'short' ? shortDate : format === 'iso' ? isoDate : fullDate;
---

<time datetime={date.toISOString()}>
	{formatted}
</time>
