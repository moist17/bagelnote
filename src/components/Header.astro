---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="header-inner">
		<div class="site-info">
			<a href="/" class="site-title">{SITE_TITLE}</a>
			<p class="tagline">have a nice day!</p>
		</div>
		<nav>
			<HeaderLink href="/about">Bagel Note: About</HeaderLink>
			<HeaderLink href="/sketchbook">Sketchbook</HeaderLink>
			<HeaderLink href="/blog-roll">♥</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</nav>
	</div>
</header>

<style>
	header {
		padding: 2rem 0 1.5rem;
	}
	.header-inner {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
		max-width: 860px;
		margin-left: auto;
		margin-right: auto;
		padding-left: 3rem;
		padding-right: 3rem;
	}
	.site-title {
		font-size: 1rem;
		font-weight: 700;
		display: block;
		margin-bottom: 0.15rem;
	}
	.site-title:hover {
		opacity: 1;
	}
	.tagline {
		margin: 0;
		font-size: 0.875rem;
		color: var(--fg-muted);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		justify-content: flex-end;
		padding-top: 0.1rem;
	}

	@media (max-width: 640px) {
		header {
			padding: 1.5rem 0 1rem;
		}
		.header-inner {
			flex-direction: column;
			gap: 1rem;
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}
		nav {
			justify-content: flex-start;
		}
	}
</style>
